{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@local/styles": [
        "src/utilities/styles.module.css"
      ],
      "@local/cx": [
        "src/utilities/utility.ts"
      ],
      "@local/types": [
        "src/utilities/types.ts"
      ],
      "@local/utils": [
        "src/utilities/utils.ts"
      ]
    },
    "target": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "bun-types",
      "vite/client"
    ],
    /* JSX */
    "jsx": "react-jsx",
    /* Emit */
    "noEmit": true,
    /* Interop */
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src"
  ],
  "exclude": []
}
